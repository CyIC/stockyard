# Environment configuration for Stockyard (the Warren Discord bot and the stockyard CLI)
# Copy this file to .env and fill in your values. DO NOT commit .env to version control.
# Docker Compose reads .env automatically; for local runs, export the variables in your shell.

# --- Read by stockyard ------------------------------------------------------------------------

# Writable directory for the same-day market-data cache (cache/<TICKER>.json).
# Default: the current working directory. The Docker image sets /app/data. (Formerly WARREN_DATA_DIR.)
STOCKYARD_DATA_DIR=./data

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default INFO. Logs go to stderr. (Formerly LOGGING.)
LOGGING_LEVEL=INFO

# Discord bot token, needed only by Warren (the bot). Give ONE of:
#   DISCORD_TOKEN       the token itself
#   DISCORD_TOKEN_FILE  path to a file containing it (Docker/Swarm secret, e.g. /run/secrets/discord_token)
# Resolution order: DISCORD_TOKEN, then DISCORD_TOKEN_FILE, then [discord] token in bot_config.ini.
DISCORD_TOKEN=your_discord_bot_token_here
# DISCORD_TOKEN_FILE=/run/secrets/discord_token

# --- Not read by stockyard v1 (kept for deployment tooling and future features) ----------------
DEBUG_MODE=false
DISCORD_APP_ID=your_discord_application_id
DISCORD_PUBLIC_KEY=your_discord_public_key
FRED_KEY=abc1234567890123abc12345

# How to get the Discord values:
# 1. Create an application at https://discord.com/developers/applications
# 2. Bot section: copy the token (DISCORD_TOKEN)
# 3. General Information: App ID and Public Key
#
# Market data comes from Yahoo Finance via yfinance, which needs no API key.
